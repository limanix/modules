# The 26 colors of a Catppuccin flavor drawn from a theme's palette, so that a template written
# for Catppuccin draws any theme by role.
palette: {
  rosewater = palette.pink;
  flamingo = palette.pink;
  inherit (palette)
    pink
    red
    yellow
    green
    blue
    ;
  mauve = palette.purple;
  maroon = palette.red;
  peach = palette.orange;
  teal = palette.cyan;
  sky = palette.cyan;
  sapphire = palette.blue;
  lavender = palette.accent;
  text = palette.foreground;
  subtext1 = palette.subtle;
  subtext0 = palette.subtle;
  overlay2 = palette.muted;
  overlay1 = palette.muted;
  overlay0 = palette.border;
  surface2 = palette.border;
  surface1 = palette.selection;
  surface0 = palette.surface;
  base = palette.background;
  mantle = palette.background_dark;
  crust = palette.background_darker;
}
